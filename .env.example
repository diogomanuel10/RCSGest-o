# Copia este ficheiro para `.env` e preenche com os valores do teu projeto Supabase.
# Encontras estes valores no painel do Supabase em: Project Settings -> API
#
#   VITE_SUPABASE_URL      = "Project URL"
#   VITE_SUPABASE_ANON_KEY = "anon public" key
#
# A anon key é segura no cliente DESDE QUE o Row Level Security (RLS) esteja ativo.
# NUNCA uses aqui a service_role key.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Notificações push (opcional, mas é o que faz a app notificar como uma
# app normal no Android e no iOS) ---------------------------------------
#
# Gera o par de chaves uma vez, na tua máquina:
#     npx web-push generate-vapid-keys
#
# A PÚBLICA vai aqui (é pública de propósito: identifica o remetente).
# A PRIVADA vai só para os segredos da Edge Function `send-push` — nunca
# para este ficheiro nem para o browser. Ver supabase/web-push.sql.
#
# Sem esta variável a app funciona na mesma: as notificações continuam a
# aparecer no sino, só não saem para o telemóvel com a app fechada.

VITE_VAPID_PUBLIC_KEY=
